# Jev client secret — copy to .env and fill in. Never commit .env.
# The same OpenRouter key works for chat and for the Decisions API.
# Only needed for the OpenRouter provider (scripts/).
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional: run the live smoke tests (tests/test_live_smoke.py) against the real API.
# JEV_LIVE=1

# ------------------------------------------------------------------------------
# OpenCode Zen provider (opencode/) — NOT required.
# The free model jev-1.13-free needs no key at all. Set a key only to use the
# paid jev-1.13, which costs $0.042/1M input tokens and needs a funded workspace.
# ------------------------------------------------------------------------------
# OPENCODE_ZEN_API_KEY=sk-...

# The Zen live suite is on by default because it is free; set this to skip it offline.
# JEV_SKIP_ZEN_LIVE=1
